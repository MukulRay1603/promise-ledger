# Optional. The demo works without a key. Copy to .env to turn on live extraction. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
# Optional: model tried once if the main one is busy (503/504) or times out (default: gemini-flash-lite-latest)
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Optional: storage backend. local (default, data/runtime/) or gcp (Firestore + Cloud Storage)
# STORAGE=local
# GCS_BUCKET=
# FIRESTORE_DATABASE=(default)
# PUBLIC_BASE_URL=https://your-service.run.app
# SEED=1
