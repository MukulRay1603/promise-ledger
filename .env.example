# Optional. The demo works without a key. Copy to .env to turn on live extraction. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
# Optional: model tried once if the main one is busy (503/504) or times out (default: gemini-flash-lite-latest)
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Optional: storage backend. local (default, data/runtime/) or gcp (Firestore + Cloud Storage)
# STORAGE=local
# GCS_BUCKET=
# FIRESTORE_DATABASE=(default)
# PUBLIC_BASE_URL=https://your-service.run.app
# SEED=1
# Optional: where the explainer videos live (NN-slug.mp4, .vtt, .jpg), e.g. a public bucket folder.
# Empty means /static/media/. The bucket needs CORS for GET so captions load.
# MEDIA_BASE_URL=https://storage.googleapis.com/your-bucket/media/
# Public demo guard (on by default; set DEMO_MODE=0 for a staff deployment).
# Per-IP limits per hour, and hours before visitor deals and uploads are deleted.
# DEMO_MODE=1
# RATE_LIMIT_UPLOADS_PER_HOUR=5
# RATE_LIMIT_DEALS_PER_HOUR=3
# DEMO_TTL_HOURS=24
# RATE_LIMIT_SHARES_PER_HOUR=20
# RATE_LIMIT_EXTRACTS_PER_HOUR=30
# RATE_LIMIT_EXPORTS_PER_HOUR=120
# Optional: parse PDFs in a separate process with a 15 s limit (default 1).
# PDF_SANDBOX=1
# Optional: most characters of one record sent to the model (default 200000).
# MAX_RECORD_CHARS=200000
# Optional: where new live readings are saved (default data/readings locally, the runtime folder on Cloud Run).
# READINGS_WRITE_DIR=
